export component Icon inherits Path {
    in property <bool> stroked: false;
    in property <brush> color: white;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
    fill: root.stroked ? transparent : root.color;
    stroke: root.stroked ? root.color : transparent;
    stroke-width: root.stroked ? 2px : 0px;
    fill-rule: evenodd;
}
