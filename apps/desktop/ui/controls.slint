import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { SeekMark } from "types.slint";

// Formats seconds as m:ss or h:mm:ss.
export global Fmt {
    pure public function time(t: float) -> string {
        if (t < 0 || t != t) {
            return "0:00";
        }
        let total = Math.floor(t);
        let h = Math.floor(total / 3600);
        let m = Math.floor(Math.mod(total, 3600) / 60);
        let s = Math.mod(total, 60);
        let ss = s < 10 ? "0" + s : "" + s;
        if (h > 0) {
            let mm = m < 10 ? "0" + m : "" + m;
            return h + ":" + mm + ":" + ss;
        }
        return m + ":" + ss;
    }
}

// Round icon button with hover glow and press scale animation.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> stroked: false;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <length> size: 36px;
    in property <length> icon-size: 20px;
    in property <string> tooltip;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: root.primary ? Theme.accent-gradient
        : touch.has-hover ? #ffffff18 : transparent;
    drop-shadow-blur: root.primary ? (touch.has-hover ? 26px : 16px) : 0px;
    drop-shadow-color: root.primary ? Theme.accent.with-alpha(0.50) : transparent;
    animate background, drop-shadow-blur { duration: Theme.fast; }

    content := Rectangle {
        width: root.icon-size;
        height: root.icon-size;
        Icon {
            width: parent.width;
            height: parent.height;
            commands: root.icon;
            stroked: root.stroked;
            color: root.primary ? #0b0d14 : root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-dim;
            animate color { duration: Theme.fast; }
        }
        // Scale feedback via a short resize on press.
        states [
            pressed when touch.pressed: {
                width: root.icon-size * 0.86;
                height: root.icon-size * 0.86;
            }
        ]
        animate width, height { duration: 90ms; easing: ease-out; }
    }

    // Small dot under active toggle buttons.
    if root.active && !root.primary: Rectangle {
        y: root.height - 6px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Text button used in the top bar and dialogs.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> stroked: false;
    in property <bool> filled: false;
    callback clicked();

    height: 34px;
    min-width: row.preferred-width + 24px;
    border-radius: self.height / 2;
    background: root.filled ? Theme.accent-gradient : touch.has-hover ? #ffffff1c : #ffffff0c;
    border-width: root.filled ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.fast; }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: root.icon;
            stroked: root.stroked;
            color: root.filled ? #0b0d14 : Theme.text;
        }
        Text {
            text: root.text;
            color: root.filled ? #0b0d14 : Theme.text;
            font-size: Theme.font-normal;
            font-weight: root.filled ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Seek bar. Reports scrubbing while dragging and the final position on release.
export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <bool> enabled: duration > 0;
    callback scrub(float);
    callback seek(float);
    // Preview pictures: `hover(t)` asks for the picture at t seconds; the
    // answer comes back as `thumb` (shown while `has-thumb`).
    callback hover(float);
    in property <image> thumb;
    in property <bool> has-thumb: false;
    // A part of the file to mark on the bar (the intro of an episode), in seconds.
    in property <float> mark-start: -1;
    in property <float> mark-end: -1;
    // More parts to mark: sponsors and the like.
    in property <[SeekMark]> marks;
    // Chapter starts, in seconds (ticks on the bar), and the chapter name
    // for a time (shown in the tooltip; "" for none).
    in property <[float]> chapters;
    pure callback chapter-name(float) -> string;
    // Bookmarks, in seconds: small marks above the bar.
    in property <[float]> bookmarks;

    property <float> drag-value: 0;
    property <bool> dragging: false;
    property <float> shown: root.dragging ? root.drag-value
        : root.duration > 0 ? Math.clamp(root.position / root.duration, 0, 1) : 0;
    property <float> hover-frac: Math.clamp(touch.mouse-x / root.width, 0, 1);
    property <bool> hot: (touch.has-hover || root.dragging) && root.enabled;

    height: 22px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.hot ? 6px : 4px;
        border-radius: self.height / 2;
        background: #ffffff1e;
        animate height { duration: Theme.fast; }

        // Hover preview fill
        if root.hot: Rectangle {
            x: 0;
            width: parent.width * root.hover-frac;
            border-radius: parent.border-radius;
            background: #ffffff16;
        }
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: parent.border-radius;
            background: Theme.accent-gradient;
        }
        if root.mark-end > root.mark-start && root.mark-start >= 0 && root.duration > 0: Rectangle {
            x: parent.width * Math.clamp(root.mark-start / root.duration, 0, 1);
            width: parent.width * Math.clamp((root.mark-end - root.mark-start) / root.duration, 0, 1);
            border-radius: parent.border-radius;
            background: #ffd04a60;
        }
        for m in root.marks: Rectangle {
            visible: root.duration > 0;
            x: parent.width * Math.clamp(m.start / Math.max(root.duration, 0.001), 0, 1);
            width: Math.max(2px, parent.width * Math.clamp((m.end - m.start) / Math.max(root.duration, 0.001), 0, 1));
            border-radius: parent.border-radius;
            background: m.main ? #4ade80a0 : #38bdf890;
        }
        for b in root.bookmarks: Rectangle {
            visible: root.duration > 0;
            x: parent.width * Math.clamp(b / Math.max(root.duration, 0.001), 0, 1) - 3px;
            y: -7px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffd04a;
        }
        for c in root.chapters: Rectangle {
            visible: c > 0 && root.duration > 0 && c < root.duration;
            x: parent.width * Math.clamp(c / Math.max(root.duration, 0.001), 0, 1) - 1px;
            width: 2px;
            background: #0b0e18c0;
        }
    }

    knob := Rectangle {
        property <length> d: root.hot ? 14px : 0px;
        x: root.width * root.shown - self.d / 2;
        y: (parent.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: white;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.accent.with-alpha(0.63);
        animate d { duration: Theme.fast; easing: ease-out; }
    }

    // Time tooltip above the cursor
    if root.hot && root.has-thumb: Rectangle {
        property <float> frac: root.dragging ? root.drag-value : root.hover-frac;
        property <length> w: 176px;
        width: self.w + 4px;
        height: self.w * Math.max(0.3, root.thumb.height / Math.max(1, root.thumb.width)) + 4px;
        x: Math.clamp(root.width * self.frac - self.width / 2, 0, root.width - self.width);
        y: -30px - self.height;
        border-radius: 8px;
        background: #000000;
        border-width: 2px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000a0;
        clip: true;
        Image {
            x: 2px;
            y: 2px;
            width: parent.w;
            height: parent.height - 4px;
            source: root.thumb;
            image-fit: contain;
        }
    }

    if root.hot: Rectangle {
        property <float> frac: root.dragging ? root.drag-value : root.hover-frac;
        width: tip.preferred-width + 14px;
        height: 22px;
        x: Math.clamp(root.width * self.frac - self.width / 2, 0, root.width - self.width);
        y: -26px;
        border-radius: 6px;
        background: Theme.surface-hi;
        border-width: 1px;
        border-color: Theme.border;
        property <string> chapter: root.chapters.length > 0 ? root.chapter-name(self.frac * root.duration) : "";
        tip := Text {
            text: parent.chapter != "" ? Fmt.time(parent.frac * root.duration) + "  ·  " + parent.chapter : Fmt.time(parent.frac * root.duration);
            color: Theme.text;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragging = true;
                root.drag-value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.scrub(root.drag-value * root.duration);
            } else if (e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.seek(root.drag-value * root.duration);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.scrub(root.drag-value * root.duration);
            }
        }
        changed mouse-x => {
            if (self.has-hover && root.enabled) {
                root.hover((root.dragging ? root.drag-value : root.hover-frac) * root.duration);
            }
        }
    }
}

// Horizontal slider for volume (0..max).
export component Slider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 100;
    callback changed(float);

    property <bool> hot: touch.has-hover || touch.pressed;
    property <float> frac: Math.clamp(root.value / root.maximum, 0, 1);
    height: 20px;
    width: 96px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff1e;
        Rectangle {
            x: 0;
            width: parent.width * root.frac;
            border-radius: 2px;
            background: Theme.accent-gradient;
        }
    }
    Rectangle {
        property <length> d: root.hot ? 12px : 8px;
        x: root.width * root.frac - self.d / 2;
        y: (parent.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: white;
        animate d { duration: Theme.fast; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.changed(Math.clamp(self.mouse-x / root.width, 0, 1) * root.maximum);
            }
        }
        moved => {
            if (self.pressed) {
                root.changed(Math.clamp(self.mouse-x / root.width, 0, 1) * root.maximum);
            }
        }
        scroll-event(e) => {
            root.changed(Math.clamp(root.value + (e.delta-y > 0 ? 5 : -5), 0, root.maximum));
            accept
        }
    }
}

// One row in a popup menu.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked: false;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    background: touch.has-hover ? #ffffff14 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.checked ? Theme.accent : transparent;
            }
        }
        Text {
            text: root.text;
            color: root.checked ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MenuHeader inherits Text {
    color: Theme.text-faint;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    height: 24px;
    vertical-alignment: center;
}
