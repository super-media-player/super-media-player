export { Theme, Clock, Classic, Silver, PlaylistItem, TrackItem, PlaylistWindow, NavWindow, InfoRow, PictureState, ShortcutRow, ScriptRow, SubHit, LibraryRow, MediaCard, MediaLine, SeekMark }

// Slowly drifting colored glows behind the UI when no video is shown.
component AmbientBackground inherits Rectangle {
    in property <bool> playing;
    property <float> t: Clock.ms;
    background: @linear-gradient(160deg, Theme.bg-2 0%, Theme.bg 70%);

    Rectangle {
        width: root.width * 0.9;
        height: self.width;
        x: root.width * 0.05 + Math.sin(root.t * 0.004deg) * 40px;
        y: -root.height * 0.45 + Math.cos(root.t * 0.003deg) * 30px;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.19) 0%, Theme.accent.with-alpha(0.00) 65%);
    }
    Rectangle {
        width: root.width * 0.8;
        height: self.width;
        x: root.width * 0.35 + Math.cos(root.t * 0.0036deg) * 50px;
        y: root.height * 0.35 + Math.sin(root.t * 0.0045deg) * 40px;
        background: @radial-gradient(circle, Theme.accent-2.with-alpha(0.16) 0%, Theme.accent-2.with-alpha(0.00) 65%);
    }
}

// Spinning disc with an animated light streak, shown for audio playback.
component SpinningDisc inherits Rectangle {
    in property <bool> playing;
    property <float> t: Clock.ms;
    property <angle> spin: root.t * 0.045deg;
    // Smaller when the window leaves less room (the navigation dock, say).
    in property <length> size: 260px;

    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    drop-shadow-blur: 60px;
    drop-shadow-color: root.playing ? Theme.accent.with-alpha(0.33) : #00000080;
    animate drop-shadow-color { duration: 600ms; }
    background: @radial-gradient(circle, #1b2030 0%, #0c0f18 70%, #05060a 100%);
    clip: true;

    for r[i] in [0.92, 0.82, 0.72, 0.62, 0.52]: Rectangle {
        width: root.width * r;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #ffffff10;
    }
    Rectangle {
        width: root.width;
        height: root.height;
        transform-rotation: root.spin;
        Rectangle {
            x: root.width / 2 - 2px;
            y: 0;
            width: root.width * 0.5;
            height: root.height * 0.5;
            background: @linear-gradient(135deg, #ffffff22 0%, #ffffff00 60%);
        }
    }
    // Label in the middle
    Rectangle {
        width: root.width * 0.34;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent-gradient;
        transform-rotation: root.spin;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: Theme.bg;
        }
        Rectangle {
            x: parent.width * 0.62;
            y: parent.height * 0.2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #ffffff90;
        }
    }
}

// Spectrum bars under the disc, mirrored so the bass sits in the middle.
// `levels` are live band heights (0..1, bass first) from meter.rs.
component PulseBars inherits Rectangle {
    in property <bool> playing;
    in property <[float]> levels;
    property <int> half: max(1, root.levels.length);
    height: 40px;
    width: 330px;
    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        for i in root.half * 2: Rectangle {
            property <float> a: root.playing ? root.levels[i < root.half ? root.half - 1 - i : i - root.half] : 0;
            width: 4px;
            height: 4px + (root.height - 4px) * self.a;
            y: (root.height - self.height) / 2;
            border-radius: 2px;
            background: Theme.accent-gradient;
            opacity: 0.45 + 0.55 * self.a;
        }
    }
}

// A heart-monitor line scrolling right to left across the music view: about
// 25 s of the song, fading out at the old (left) end, with a glowing head.
// `commands` come from pulse.rs in a viewbox 750 wide and as tall as this
// line's shape (`pulse-aspect`), so the trace is not stretched.
component PulseLine inherits Rectangle {
    in property <string> commands;
    in property <float> beat;
    // Newest value, -1 (bottom) .. 1 (top): where the pen is.
    in property <float> head;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 750;
        viewbox-height: 750 * root.height / Math.max(1px, root.width);
        commands: root.commands;
        stroke: @linear-gradient(90deg, Theme.accent.transparentize(100%) 0%, Theme.accent.transparentize(75%) 35%, Theme.accent.mix(Theme.accent-2, 50%).transparentize(25%) 75%, Theme.accent-2 100%);
        stroke-width: 2px + 1.5px * root.beat;
        fill: transparent;
    }
    // The pen at the right edge, brighter on a beat.
    Rectangle {
        x: root.width - self.width / 2 - 1px;
        y: root.height / 2 * (1 - root.head * 0.92) - self.height / 2;
        width: 8px + 6px * root.beat;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent-2.brighter(40%);
        opacity: 0.55 + 0.45 * root.beat;
        drop-shadow-blur: 12px + 10px * root.beat;
        drop-shadow-color: Theme.accent-2;
    }
}

// Particles streaming out from the middle, thrown outwards and brightened by
// every beat; a glowing core breathes with the loudness. Drawn by the UI, so
// it is smooth and costs no video decoding.
component ParticleField inherits Rectangle {
    in property <bool> playing;
    in property <float> beat;
    in property <float> energy;
    property <float> t: animation-tick() / 1000ms;
    property <length> reach: Math.min(root.width, root.height) * 0.62;
    clip: true;
    // Core glow.
    Rectangle {
        property <length> d: 70px + 60px * root.energy + 50px * root.beat;
        x: (root.width - self.d) / 2;
        y: (root.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: @radial-gradient(circle, Theme.accent-2.with-alpha(0.63) 0%, Theme.accent.with-alpha(0.25) 45%, Theme.accent.with-alpha(0.00) 70%);
    }
    for i in 90: Rectangle {
        // Fixed per particle: direction (golden angle), speed, start offset.
        property <angle> dir: i * 137.508deg;
        property <float> speed: 0.07 + Math.mod(i * 0.618034, 1) * 0.11;
        property <float> life: Math.mod(root.t * self.speed + Math.mod(i * 0.371, 1), 1);
        property <length> r: root.reach * (0.08 + self.life * self.life * 0.92)
            + 46px * root.beat * (1 - self.life);
        property <length> size: (2px + Math.mod(i * 0.29, 1) * 3px) * (1 + 1.6 * root.beat);
        x: root.width / 2 + self.r * Math.cos(self.dir) - self.size / 2;
        y: root.height / 2 + self.r * Math.sin(self.dir) - self.size / 2;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: Math.mod(i, 3) == 0 ? Theme.accent-2 : Math.mod(i, 3) == 1 ? Theme.accent : #e6dcff;
        opacity: root.playing
            ? (1 - self.life) * (0.25 + 0.55 * root.energy + 0.4 * root.beat)
            : 0.15 * (1 - self.life);
    }
}

// Timed lyrics: the line being sung, bright, between the last and the next.
component LyricLines inherits VerticalLayout {
    in property <string> prev;
    in property <string> current;
    in property <string> next;
    spacing: 4px;
    width: 640px;
    Text {
        text: root.prev;
        color: Theme.text-faint;
        horizontal-alignment: center;
        overflow: elide;
        font-size: 14px;
    }
    Text {
        text: root.current;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
        font-size: 19px;
        font-weight: 700;
    }
    Text {
        text: root.next;
        color: Theme.text-dim;
        horizontal-alignment: center;
        overflow: elide;
        font-size: 14px;
    }
}

// Three dots pulsing in sequence: "something is loading".
component LoadingDots inherits HorizontalLayout {
    in property <length> size: 7px;
    spacing: self.size * 0.7;
    property <float> phase: mod(animation-tick() / 1200ms, 1);
    for i in 3: Rectangle {
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: Theme.accent-gradient;
        // Each dot peaks a third of a cycle after the previous one.
        opacity: 0.25 + 0.75 * Math.max(0, 1 - Math.abs(mod(root.phase - i / 3 + 1, 1) - 0.5) * 3);
    }
}

export component AppWindow inherits Window {
    title: root.media-title != "" ? root.media-title + " — Super Media Player" : "Super Media Player";
    icon: @image-url("../../../packaging/linux/super-media-player.svg");
    min-width: root.view == 1 ? 400px : root.view == 2 ? 470px : root.view == 3 ? 560px : root.nav-docked ? 760px : root.own-bar ? max(520px, menu-width.total + 180px) : 520px;
    // 420px: the longest menu (Playback) must fit below the menu bar; Slint
    // menus can't scroll, so a shorter window cut it off.
    min-height: root.view == 1 ? 210px : root.view == 2 ? (root.classic-docked ? 196px + 120px : 196px)
        : root.view == 3 ? (root.playlist-open ? 340px + 120px : 340px) : root.nav-docked ? 420px + root.nav-dock-height : 420px;
    // The classic deck on its own only resizes horizontally. (Anything at or
    // above i32::MAX means "no limit" to Slint: no size hint goes to the
    // window manager, so maximizing keeps working in the other views.)
    // An open panel needs more room than they have (main.rs `fit_panel`).
    max-height: root.panel-open ? 10000000000px
        : root.view == 2 && !root.classic-docked ? 196px
        : root.view == 3 && !root.playlist-open ? 340px : 10000000000px;
    // The silver deck is drawn for its width; only its playlist drawer
    // resizes (downwards).
    max-width: root.view == 3 ? 600px : 10000000000px;
    // The skinned players are the whole window: no title bar, no menu bar;
    // each skin has its own menu, window buttons and drag area. The media
    // player draws its title bar into the menu bar (titlebar.slint).
    no-frame: root.compact || root.own-bar;
    preferred-width: 1100px;
    preferred-height: 680px;
    // Transparent so the video rendered underneath shows through.
    background: transparent;
    default-font-size: Theme.font-normal;
    forward-focus: keys;

    // ---- state pushed from Rust ----
    in property <bool> idle: true;
    in property <bool> paused: true;
    in property <bool> has-video: false;
    // A music visualizer is drawing (mpv renders it like video).
    in property <bool> visual-active: false;
    // Live spectrum bar heights (0..1, bass first), from meter.rs.
    in property <[float]> spectrum;
    // Beat (1 on a bass hit, decaying) and loudness, 0..1, plus the pulse
    // line's path (pulse.rs).
    in property <float> beat;
    in property <float> energy;
    in property <string> pulse-path;
    in property <float> pulse-head;
    // Height / width of the pulse line, so pulse.rs draws it unstretched.
    out property <float> pulse-aspect: root.pulse-height / Math.max(1px, root.pulse-width);
    property <length> pulse-width: root.width - (root.playlist-open ? playlist-panel.width + 14px : 0px);
    property <length> pulse-height: Math.min(180px, root.height * 0.22);
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 100;
    in property <bool> muted: false;
    in property <float> speed: 1;
    in property <string> media-title;
    in property <string> media-subtitle;
    in property <string> media-artist;
    in property <string> tech-info;
    in property <string> audio-info;
    in property <string> buffering-text;
    // Longer work started by the user, e.g. "Reading the disc…".
    in property <string> busy-text;
    in property <bool> starting: true;
    in property <image> artist-image;
    in property <bool> has-artist-image: false;
    // The song beyond its title (musicinfo.rs): album cover, tags, a short
    // artist summary and lyrics. Timed lyrics show the sung line and its
    // neighbours.
    in property <string> media-album;
    in property <string> media-year;
    in property <string> media-genre;
    in property <string> media-track;
    in property <image> cover-image;
    in property <bool> has-cover: false;
    in property <string> about-text;
    in property <string> about-source;
    in property <string> lyrics-text;
    in property <bool> lyrics-synced: false;
    in property <string> lyric-prev;
    in property <string> lyric-current;
    in property <string> lyric-next;
    // A panel is open over a skinned player, which is too small for it.
    out property <bool> panel-open: root.compact && (root.info-open || root.signal-open || root.library-open
        || root.subsearch-open || root.subsync-open || root.media-info-open || root.transcript-open || root.clip-open || root.remote-open
        || root.cast-open || root.party-open || root.palette-open || root.eq-open || root.settings-open
        || root.ask-open || root.makemkv-open || root.check-open);
    // A skin with nothing over it: right-clicks are for its menu, not for a
    // dialog's text field.
    out property <bool> skin-alone: root.compact && !root.panel-open && !drive-popup.is-open && !url-popup.is-open
        && !jump-popup.is-open && !about-popup.is-open && !shortcuts-popup.is-open && !disc-popup.is-open
        && !tracks-popup.is-open;
    in-out property <bool> info-open: false;
    property <bool> show-lyric-lines: root.s-show-lyrics && root.lyrics-synced
        && (root.lyric-current != "" || root.lyric-next != "");
    // About box
    in property <string> app-version;
    in property <string> app-author;
    in property <string> build-date;
    in property <string> build-year;
    in property <string> engine-info;
    in property <bool> fullscreen: false;
    in property <bool> shuffle: false;
    // 0 = off, 1 = repeat playlist, 2 = repeat one
    in property <int> repeat-mode: 0;
    in property <[PlaylistItem]> playlist;
    in property <[TrackItem]> audio-tracks;
    in property <[TrackItem]> subtitle-tracks;
    in property <bool> subtitles-off: true;
    in-out property <string> toast;
    in-out property <bool> playlist-open: false;
    // The classic deck's playlist is in its own window (main.rs).
    in-out property <bool> playlist-detached: false;
    property <bool> classic-docked: root.playlist-open && !root.playlist-detached;
    in-out property <bool> drop-hover: false;

    // ---- settings (indices into the option lists in main.rs) ----
    in-out property <int> s-view-mode: 0;
    // Skins (skins.rs): their names, the view (layout) each one dresses, and
    // the chosen one. The first four are the plain views, in view order.
    in property <[string]> skin-names: ["Media player", "Compact", "Classic deck (Winamp-style)", "Silver deck (MMD3-style)"];
    in property <[int]> skin-views: [0, 1, 2, 3];
    in-out property <int> s-skin: 0;
    callback reload-skins();
    callback open-skins-folder();
    in-out property <int> s-visualizer: 0;
    in-out property <int> s-artist-pos: 2;
    in-out property <bool> s-artist-online: false;
    in-out property <bool> s-pulse-line: true;
    in-out property <bool> s-lyrics-online: false;
    in-out property <bool> s-show-lyrics: true;
    in-out property <bool> s-gapless: true;
    in-out property <int> s-crossfade: 0;
    in-out property <int> s-replaygain: 0;
    in-out property <bool> s-resume: true;
    in-out property <bool> s-remember-pace: true;
    in-out property <bool> s-bit-perfect: false;
    in-out property <bool> s-eq-enabled: false;
    // Equalizer gains (dB, 10 bands) and preset names, from main.rs.
    in property <[float]> eq-gains;
    in property <[string]> eq-preset-names;
    in-out property <bool> eq-open: false;
    callback set-eq-band(int, float);
    callback eq-preset(int);
    callback set-eq-enabled(bool);
    callback ab-loop();
    callback frame-step(bool);
    callback start-over();
    in-out property <int> s-stream-quality: 2;
    in-out property <bool> s-hw-decoding: true;
    in-out property <int> s-bluray-decryption: 0;
    in-out property <int> s-window-system: 0;
    in-out property <bool> s-auto-update: true;
    in property <string> ytdlp-status;
    in property <string> keydb-status;
    in property <string> disc-status;
    // ---- everyday basics (basics.rs) ----
    // One action for the small things: ("audio-delay", +0.1), ("chapter", 3),
    // ("aspect", 1), ("sleep", 2), ("recent", 0), ...
    callback basic(string, float);
    // Jump to a typed time ("1:23:45", "90", "50%"); false if it can't be read.
    callback jump-to(string) -> bool;
    pure callback chapter-name(float) -> string;
    in property <[float]> chapter-times;
    in property <[string]> chapter-titles;
    in property <int> chapter-current: -1;
    in property <[string]> recent-files;
    in property <[string]> audio-devices;
    in-out property <int> s-audio-device;
    in property <string> audio-delay-text: "0 ms";
    in property <string> sub-delay-text: "0 ms";
    // 0 off, 1..5: 15/30/45/60/90 minutes, 6: at the end of this file.
    in property <int> sleep-choice: 0;
    in property <string> sleep-left;
    in property <PictureState> picture;
    in-out property <bool> picture-open;
    in property <[InfoRow]> media-info-rows;
    in-out property <bool> media-info-open;
    in property <string> media-info-text;
    in-out property <bool> s-always-on-top;
    // 0 = the player's own title bar, 1 = the desktop's.
    in-out property <int> s-title-bar: 0;
    // Where the menu bar is the desktop's own (macOS), there's no row to put it in.
    in property <bool> own-bar-possible: true;
    in property <bool> window-focused: true;
    in property <bool> window-maximized;
    property <bool> own-bar: root.s-title-bar == 0 && root.own-bar-possible;
    // Our own frame is showing: rounded corners, and edges that resize.
    out property <bool> own-frame: root.own-bar && !root.compact && !root.fullscreen && !root.window-maximized;
    out property <color> bar-color: Theme.bg-2;
    callback toggle-maximize();
    callback system-window-menu(length, length) -> bool;
    in-out property <bool> s-single-instance: true;
    in-out property <int> s-sub-size: 1;
    in-out property <int> s-sub-pos: 0;
    in-out property <int> s-sub-color: 0;
    in-out property <int> s-sub-style: 1;
    in-out property <int> s-passthrough: 0;
    in-out property <bool> s-dvd-menus: true;
    in-out property <bool> s-sub-auto-sync: true;
    // DVD menus (dvdmenu/): a disc is being played with its own program; its
    // menu is up; the menu has buttons, and one is under the mouse.
    in property <bool> dvd-disc;
    in property <bool> dvd-menu;
    in property <bool> dvd-buttons;
    in property <bool> dvd-over-button;
    in property <bool> dvd-can-return;
    // A menu with buttons: the picture keeps clear of the bars, so that they
    // never cover a button.
    property <bool> dvd-fit: root.dvd-menu && root.dvd-buttons && !root.compact;
    property <bool> dvd-playing: root.media-playing == "dvd://" || root.media-playing.starts-with("dvd://");
    callback dvd(string);
    callback dvd-mouse(float, float, bool);
    // Bookmarks in the current file (basics.rs).
    in property <[float]> bookmark-times;
    in property <[string]> bookmark-titles;
    public function show-jump() { open-jump.running = true; }
    public function show-settings-tab(t: int) { root.settings-tab = t; root.show-settings(); }

    // ---- your shortcuts and mouse actions (shortcuts.rs) ----
    // A key press: true when one of your shortcuts took it.
    callback key-binding(string, bool, bool, bool) -> bool;
    // The skins' menu at this place, or far enough to the left that a
    // sub-menu (280px each) has room beside it: Slint keeps menus inside the
    // window, so it would open over the first one. Also called by main.rs, for
    // right-clicks.
    public function show-skin-menu(x: length, y: length) {
        skin-menu.show({ x: Math.max(0px, Math.min(x, root.width - 560px)), y: y });
    }
    // A key was released, or the keyboard went elsewhere.
    callback key-let-go();
    // The user's mpv scripts (scripts.rs): "folder", "refresh", "toggle" a file.
    callback scripts-action(string, string);
    in property <[ScriptRow]> script-rows;
    in property <string> scripts-off;
    in-out property <bool> s-scripts: true;
    changed settings-open => { if (root.settings-open) { root.scripts-action("show", ""); } }
    callback shortcut-capture(string, bool, bool, bool) -> string;
    callback shortcut-add(string, int);
    callback shortcut-remove(int);
    callback mouse-action(string);
    in property <[ShortcutRow]> shortcut-rows;
    in property <[string]> shortcut-actions;
    in-out property <int> s-mouse-wheel: 0;
    in-out property <int> s-mouse-double: 0;
    in-out property <int> s-mouse-middle: 0;

    // Recording a stream as it plays (basics.rs).
    in property <bool> recording;
    in property <bool> can-record;
    in property <string> recording-text;

    // ---- the Library (library.rs) ----
    in-out property <bool> library-open;
    in-out property <int> library-tab;
    in-out property <int> library-group;
    in-out property <string> library-country;
    in property <[LibraryRow]> library-rows;
    in property <string> library-status;
    in property <bool> library-busy;
    in property <bool> library-episodes;
    callback library-show();
    callback library-search(string);
    callback library-activate(int);
    callback library-toggle-save(int);
    callback library-add(string, string);
    callback library-save-current();
    callback library-play-all();
    callback library-back();
    callback library-rescan();
    callback library-connect(string, string, string);
    in-out property <string> library-user;
    in-out property <string> library-password;
    public function show-library(tab: int) { root.library-tab = tab; root.library-open = true; root.library-show(); }

    // ---- the media library (collection.rs) ----
    in-out property <bool> media-open;
    // 0 Home, 1 Albums, 2 Artists, 3 Genres, 4 Songs, 5 Videos, 6 Folders,
    // 7 managing the folders, -1 search.
    in property <int> media-page;
    in property <string> media-heading;
    in property <string> media-subheading;
    in property <bool> media-can-back;
    in property <bool> media-can-play;
    in property <MediaCard> media-head;
    in property <bool> media-has-head;
    in property <[MediaCard]> media-cards;
    in property <[MediaLine]> media-lines;
    in property <[string]> media-sorts;
    in property <int> media-sort;
    in property <[string]> media-folders;
    in property <string> media-status;
    in property <bool> media-scanning;
    in property <bool> media-loading;
    in property <bool> media-empty;
    // The file being played, to mark it in the lists.
    in property <string> media-playing;
    in-out property <string> media-query;
    in-out property <length> media-scroll;
    property <int> media-focus-search;
    callback media-shown();
    callback media-closed();
    callback media-nav(int);
    callback media-back();
    callback media-search(string);
    callback media-sort-by(int);
    callback media-open-card(int);
    callback media-play-card(int);
    callback media-remove-card(int);
    callback media-play-song(int);
    callback media-add-song(int);
    callback media-play-all(string);
    callback media-layout(float);
    callback media-add-folder();
    callback media-add-defaults();
    callback media-remove-folder(int);
    callback media-rescan();
    // Open the library at a page. The skinned players are too small for it.
    public function show-media(page: int) {
        if (root.compact) { root.set-view(0); }
        root.media-open = true;
        root.media-shown();
        root.media-nav(page);
    }
    public function toggle-media() { if (root.media-open) { root.close-media(); } else { root.show-media(0); } }
    public function close-media() {
        root.media-open = false;
        root.media-closed();
        keys.focus();
    }

    // ---- subtitles online (opensubs.rs) ----
    callback show-sub-search();
    callback subsearch-search(string, string);
    callback subsearch-download(int);
    callback load-subtitle-path(string);
    in-out property <bool> subsearch-open;
    in-out property <string> subsearch-query;
    in-out property <string> subsearch-languages;
    in property <[SubHit]> subsearch-hits;
    in property <string> subsearch-status;
    in property <bool> subsearch-working;
    in property <string> opensubs-status;
    callback save-opensubs(string, string, string);

    // ---- playlist tools (playlists.rs) ----
    // ("up", i), ("down", i), ("title"|"file"|"folder"|"reverse", 0),
    // ("shuffle"|"dedupe"|"missing"|"save"|"open", 0)
    callback playlist-action(string, int);
    callback playlist-search(string);
    in-out property <string> playlist-query;
    in property <[bool]> playlist-shown;

    // The settings tab last open.
    in-out property <int> settings-tab;
    in-out property <bool> settings-open: false;

    // 0 = media player, 1 = compact, 2 = classic deck, 3 = silver deck.
    property <int> view: root.s-view-mode;
    // One of the small skinned players, rather than the full media player.
    property <bool> compact: root.view != 0;
    // Visualizer index 0 is the spinning disc, 1 particles, 7 "none".
    property <bool> show-disc: root.s-visualizer == 0;
    property <bool> show-particles: root.s-visualizer == 1;

    // Where mpv should draw video or the visualizer, in this window's content
    // coordinates; main.rs turns it into mpv's video margins.
    out property <length> content-height: root.height;
    out property <length> video-x: root.view == 1 ? compact-view.vis-x : root.view == 2 ? classic-view.vis-x : root.view == 3 ? silver-view.vis-x : 0px;
    out property <length> video-y: root.view == 1 ? compact-view.vis-y : root.view == 2 ? classic-view.vis-y : root.view == 3 ? silver-view.vis-y : root.dvd-fit ? 56px : 0px;
    out property <length> video-width: root.view == 1 ? compact-view.vis-width : root.view == 2 ? classic-view.vis-width : root.view == 3 ? silver-view.vis-width : root.width;
    out property <length> video-height: root.view == 1 ? compact-view.vis-height : root.view == 2 ? classic-view.vis-height : root.view == 3 ? silver-view.vis-height
        : root.nav-docked ? root.height - bar.height - 2 * bar.margin : root.dvd-fit ? root.height - 56px - root.bar-height - 28px : root.height;

    // ---- actions handled in Rust ----
    callback open-files();
    callback open-folder();
    // Paths, file:// URIs or URLs, one per line.
    callback open-location(string);
    callback open-disc(string);
    callback toggle-pause();
    callback stop();
    callback next();
    callback prev();
    callback seek(float);
    callback scrub(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback toggle-mute();
    callback play-index(int);
    callback remove-index(int);
    callback clear-playlist();
    callback toggle-shuffle();
    callback set-repeat(int);
    callback toggle-fullscreen();
    callback select-audio(int);
    callback select-subtitle(int);
    callback add-subtitle();
    callback set-speed(float);
    // Pauses in the sound are left out (silence.rs); how much so far ("": none).
    in-out property <bool> skip-silence: false;
    in property <string> silence-saved;
    callback toggle-skip-silence();
    callback screenshot();
    callback settings-changed();
    callback install-ytdlp();
    callback install-keydb();
    // System check (doctor.rs): run it, and a fix button was pressed.
    callback run-check();
    callback check-action(string);
    in-out property <bool> check-open: false;
    in property <[CheckItem]> check-items;
    in property <bool> check-running: false;
    in property <string> check-summary;
    in property <string> check-report;
    callback quit();
    callback minimize-window();
    // Resize the frameless (skinned) window from an edge: 0 right, 1 bottom, 2 corner.
    callback start-window-resize(int);
    // Rip & play with MakeMKV (ripper.rs), its key, and stopping a rip.
    callback rip-disc();
    callback update-ffmpeg();
    callback register-makemkv(string);
    in property <bool> busy-cancellable: false;
    callback cancel-busy();
    // A MakeMKV rip in progress (rip.slint shows it).
    in property <bool> rip-active: false;
    in property <float> rip-percent: 0;
    in property <string> rip-title;
    in property <string> rip-drive;
    in property <string> rip-stage;
    in property <string> rip-eta;
    in property <string> rip-heading;
    // A question asked inside the player (main.rs `ask`).
    in property <bool> ask-open: false;
    in property <string> ask-title;
    in property <string> ask-text;
    in property <string> ask-ok-label: "OK";
    in property <string> ask-cancel-label: "Cancel";
    callback ask-answer(bool);
    // Drives holding a disc, to pick the one to rip from.
    in property <[DriveChoice]> drive-choices;
    callback rip-from-drive(string, string);
    // The drive picker either rips (above) or plays the disc in the chosen drive.
    in property <bool> drive-picker-play;
    callback play-from-drive(string);
    public function show-drive-picker() { drive-popup.show(); }
    // MakeMKV help panel (makemkv.slint); Rust fills in the status.
    in-out property <bool> makemkv-open: false;
    in property <string> makemkv-status;
    in property <bool> makemkv-ready: false;
    in property <bool> makemkv-installed: false;
    in property <string> makemkv-install-command;
    in property <string> makemkv-update-command;
    in property <string> makemkv-key-page;
    callback refresh-makemkv();
    callback install-makemkv();
    callback open-url(string);
    public function show-makemkv-key() {
        root.makemkv-open = true;
        root.refresh-makemkv();
    }
    // Tone (silver deck knobs), -12..12 dB.
    in-out property <float> bass: 0;
    in-out property <float> treble: 0;
    callback set-bass(float);
    callback set-treble(float);
    // From Rust: a link failed because yt-dlp is missing.
    callback ytdlp-missing(string);

    // ---- beyond playback (extras.slint) ----
