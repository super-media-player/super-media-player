import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Fmt, IconButton, SeekBar, Slider } from "controls.slint";
import { PlaylistItem } from "types.slint";
import { PlaylistList } from "playlist.slint";
import { MiniBars, Marquee, TitleButton } from "skin-parts.slint";

// The compact player: a display panel with big time digits,
// a visualizer window, scrolling title and stream info, then transport
// buttons, and an optional playlist underneath.
export component CompactView inherits Rectangle {
    // Off while the view is hidden, so its animations don't keep redrawing.
    in property <bool> active: true;
    in property <bool> idle;
    in property <bool> paused;
    in property <bool> has-video;
    in property <bool> visual-active;
    // Live spectrum for the mini bars (meter.rs).
    in property <[float]> levels;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <bool> muted;
    in property <string> media-title;
    in property <string> media-subtitle;
    in property <string> audio-info;
    in property <string> tech-info;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in property <[PlaylistItem]> playlist;
    in property <image> artist-image;
    in property <bool> has-artist-image;
    in property <bool> show-artist-image;
    in-out property <bool> playlist-open;

    // Where mpv draws the visualizer (or video), relative to this view.
    out property <length> vis-x: display.x + vis-box.x;
    out property <length> vis-y: display.y + vis-box.y;
    out property <length> vis-width: vis-box.width;
    out property <length> vis-height: vis-box.height;

    callback toggle-pause();
    callback stop();
    callback next();
    callback prev();
    callback seek(float);
    callback scrub(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-files();
    callback play-index(int);
    callback remove-index(int);
    callback expand();
    // Window chrome: the skin is the whole window (no title bar).
    callback show-menu(Point);
    callback minimize();
    callback close();

    // mpv draws underneath the UI, so everything opaque must leave a hole
    // where the visualizer window is: the backgrounds are drawn as four
    // pieces around it.
    property <color> bg: #10141f;
    property <color> panel: #04060b;
    Rectangle { x: 0; y: 0; width: root.width; height: root.vis-y; background: root.bg; }
    Rectangle { x: 0; y: root.vis-y + root.vis-height; width: root.width; height: root.height - self.y; background: root.bg; }
    Rectangle { x: 0; y: root.vis-y; width: root.vis-x; height: root.vis-height; background: root.bg; }
    Rectangle { x: root.vis-x + root.vis-width; y: root.vis-y; width: root.width - self.x; height: root.vis-height; background: root.bg; }

    // Title strip: drag to move; menu, minimize and close buttons.
    WindowMoveArea {
        x: 0;
        y: 0;
        width: root.width;
        height: 28px;
    }
    TitleButton {
        x: 10px; y: 7px; glyph: "≡";
        face: #1a2132; edge: Theme.accent.with-alpha(0.25); ink: Theme.text-dim;
        clicked => { root.show-menu({ x: self.x, y: self.y + self.height + 2px }); }
    }
    Text {
        x: 32px;
        y: 7px;
        width: root.width - 32px - 54px;
        height: 14px;
        text: "SUPER MEDIA PLAYER";
        color: Theme.text-faint;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TitleButton {
        x: root.width - 10px - 2 * self.width - 3px; y: 7px; glyph: "−";
        face: #1a2132; edge: Theme.accent.with-alpha(0.25); ink: Theme.text-dim;
        clicked => { root.minimize(); }
    }
    TitleButton {
        x: root.width - 10px - self.width; y: 7px; glyph: "×";
        face: #1a2132; edge: Theme.accent.with-alpha(0.25); ink: Theme.text-dim;
        clicked => { root.close(); }
    }

    display := Rectangle {
        x: 10px;
        y: 28px;
        width: parent.width - 20px;
        height: 104px;

        // Panel fill, around the visualizer window.
        Rectangle {
            x: 0; y: 0; width: parent.width; height: vis-box.y;
            background: root.panel;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }
        Rectangle {
            x: 0; y: vis-box.y + vis-box.height; width: parent.width; height: parent.height - self.y;
            background: root.panel;
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
        }
        Rectangle { x: 0; y: vis-box.y; width: vis-box.x; height: vis-box.height; background: root.panel; }
        Rectangle {
            x: vis-box.x + vis-box.width; y: vis-box.y;
            width: parent.width - self.x; height: vis-box.height;
            background: root.panel;
        }
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.19);
        }

        // Left: state and time
        Rectangle {
            x: 12px;
            y: 10px;
            width: 128px;
            height: 50px;
            Text {
                x: 0;
                y: 4px;
                text: root.idle ? "■" : root.paused ? "❚❚" : "▶";
                color: Theme.accent;
                font-size: 14px;
            }
            Text {
                x: 22px;
                y: -4px;
                text: Fmt.time(root.position);
                color: Theme.accent;
                font-size: 38px;
                font-weight: 300;
                font-family: "DejaVu Sans Mono";
            }
        }
        // Visualizer / video window
        vis-box := Rectangle {
            x: 150px;
            y: 10px;
            width: parent.width - self.x - (root.show-artist-image && root.has-artist-image ? 72px : 12px);
            height: 52px;
            border-radius: 4px;
            // Transparent while mpv draws here, so its picture shows through.
            background: root.visual-active || root.has-video ? transparent : #0a0e18;
            border-width: 1px;
            border-color: #ffffff10;
            if !root.visual-active && !root.has-video: MiniBars {
                playing: root.active && !root.paused && !root.idle;
                levels: root.levels;
            }
            TouchArea {
                double-clicked => { root.expand(); }
            }
        }
        if root.show-artist-image && root.has-artist-image: Rectangle {
            x: parent.width - 64px;
            y: 10px;
            width: 52px;
            height: 52px;
            border-radius: 4px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.artist-image;
                image-fit: cover;
            }
        }
        // Title and info
        Marquee {
            active: root.active;
            x: 12px;
            y: 68px;
            width: parent.width - 24px;
            text: root.idle ? "Super Media Player — open something to play"
                : root.media-subtitle != "" ? root.media-title + "  ·  " + root.media-subtitle : root.media-title;
            text-color: Theme.text;
        }
        Text {
            x: 12px;
            y: parent.height - 18px;
            width: parent.width - 24px;
            text: root.has-video ? root.tech-info : root.audio-info;
            color: Theme.text-faint;
            font-size: 11px;
            overflow: elide;
        }
        Text {
            x: parent.width - 12px - self.width;
            y: parent.height - 18px;
            text: root.duration > 0 ? Fmt.time(root.duration) : "";
            color: Theme.text-faint;
            font-size: 11px;
        }
    }

    SeekBar {
        x: 12px;
        y: display.y + display.height + 4px;
        width: parent.width - 24px;
        position: root.position;
        duration: root.duration;
        scrub(t) => { root.scrub(t); }
        seek(t) => { root.seek(t); }
    }

    controls := HorizontalLayout {
        x: 8px;
        y: display.y + display.height + 28px;
        width: parent.width - 16px;
        height: 40px;
        spacing: 2px;
        IconButton { y: 4px; size: 32px; icon-size: 16px; icon: Icons.prev; clicked => { root.prev(); } }
        IconButton {
            y: 2px;
            size: 36px;
            icon-size: 18px;
            primary: true;
            icon: root.paused || root.idle ? Icons.play : Icons.pause;
            clicked => { root.toggle-pause(); }
        }
        IconButton { y: 4px; size: 32px; icon-size: 16px; icon: Icons.stop; clicked => { root.stop(); } }
        IconButton { y: 4px; size: 32px; icon-size: 16px; icon: Icons.next; clicked => { root.next(); } }
        IconButton { y: 4px; size: 32px; icon-size: 16px; icon: Icons.folder; clicked => { root.open-files(); } }
        IconButton {
            y: 4px;
            size: 32px;
            icon-size: 16px;
            icon: Icons.shuffle;
            stroked: true;
            active: root.shuffle;
            clicked => { root.toggle-shuffle(); }
        }
        IconButton {
            y: 4px;
            size: 32px;
            icon-size: 16px;
            icon: Icons.repeat;
            stroked: true;
            active: root.repeat-mode > 0;
            clicked => { root.cycle-repeat(); }
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            y: 4px;
            size: 32px;
            icon-size: 16px;
            icon: root.muted || root.volume == 0 ? Icons.mute : Icons.volume;
            clicked => { root.toggle-mute(); }
        }
        Slider {
            y: 10px;
            width: 80px;
            value: root.volume;
            maximum: 150;
            changed(v) => { root.set-volume(v); }
        }
        IconButton {
            y: 4px;
            size: 32px;
            icon-size: 16px;
            icon: Icons.playlist;
            active: root.playlist-open;
            clicked => { root.playlist-open = !root.playlist-open; }
        }
        IconButton {
            y: 4px;
            size: 32px;
            icon-size: 16px;
            icon: Icons.fullscreen;
            clicked => { root.expand(); }
        }
    }

    if root.playlist-open: Rectangle {
        x: 10px;
        y: controls.y + controls.height + 6px;
        width: parent.width - 20px;
        height: parent.height - self.y - 10px;
        border-radius: 8px;
        background: #04060bc0;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        if root.playlist.length == 0: Text {
            text: "Nothing queued: open files, a folder, or drop them here.";
            color: Theme.text-faint;
            font-size: Theme.font-small;
        }
        PlaylistList {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            items: root.playlist;
            row-height: 26px;
            dense: true;
            play(i) => { root.play-index(i); }
            remove(i) => { root.remove-index(i); }
        }
    }
}
